GROQ_API_KEY=gsk_...

# Email accounts (used as labels only — Playwright handles login interactively on first run)
GMAIL_1_EMAIL=your.first@gmail.com
GMAIL_2_EMAIL=your.second@gmail.com
OUTLOOK_EMAIL=your@outlook.com

# Display names shown in the left panel (defaults to domain name if not set)
GMAIL_1_LABEL=Work
GMAIL_2_LABEL=Side Project
OUTLOOK_LABEL=Client

# Optional corporate Okta portal used to sign in to Outlook + Teams (leave empty to go direct)
MYAPPS_URL=

# Background polling interval in minutes (default: 15)
# Scrapers re-run silently; only new items since last briefing trigger a notification
POLL_INTERVAL_MINUTES=15

# Optional scheduled briefings in local 24-hour time, comma-separated
# Example: BRIEFING_TIMES=09:00,17:30
BRIEFING_TIMES=

# Browser scraper reliability controls
SCRAPER_TIMEOUT_SECONDS=90
SCRAPER_RETRIES=1
